# ==============================================================================
# Git Exclusions for ButterflyAI Species Classification Project
# ==============================================================================

# --- Image Datasets & All Image Formats ---
images/
dataset/
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.gif
*.tiff
*.tif
*.svg
*.ico

# --- Presentations, Word Documents, Office Files & Reports ---
*.pptx
*.ppt
*.ppsx
*.docx
*.doc
*.rtf
*.pdf
*.xlsx
*.xls
*.csv

# --- Machine Learning Models & Weights ---
model/*.h5
model/*.keras
model/*.onnx
model/*.tflite
model/labels.txt
*.tflite
*.keras
*.h5

# --- Compiled Java Class Files & Target Build Output ---
target/
*.class

# --- Python Cache & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/

# --- IDE & OS Cache Files ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.log
